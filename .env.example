# Correo de la empresa (configurado automáticamente por el instalador)
EMAIL_FROM=tucorreo@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Servidor SMTP (opcional, por defecto: smtp.gmail.com)
EMAIL_SMTP=smtp.gmail.com

# Puerto SMTP (opcional, por defecto: 587)
EMAIL_PORT=587

# Secretos de la aplicación (generados automáticamente por el instalador)
SECRET_KEY=
JWT_SECRET_KEY=

# ============================
# Visión Computacional
# ============================

# Modo de visión por defecto del sistema: cloud | local | off
# - cloud: inferencia en la nube de Roboflow (pago por inferencia, requiere internet)
# - local: inferencia local/edge (cero costo cloud, máxima privacidad, requiere paquete 'inference')
# - off:   visión desactivada (solo frame crudo)
VISION_DEFAULT_MODE=off

# --- Vision Cloud (Workflow) — modo recomendado/preferido ---
# Si WORKSPACE + WORKFLOW_ID están definidos, se usa client.run_workflow()
# (workflows personalizados de Roboflow). Salidas: tracked_predictions,
# counts_by_label, total_count, output_image.
ROBOFLOW_WORKSPACE=               # ej: oswaldos-workspace-0ikuh
ROBOFLOW_WORKFLOW_ID=             # ej: custom-workflow-4
ROBOFLOW_WORKFLOW_IMAGE_INPUT=image  # nombre del input de imagen del workflow
ROBOFLOW_WORKFLOW_USE_CACHE=true
ROBOFLOW_USE_SERVER_OVERLAY=false    # true = usar output_image del workflow; false = dibujar local

# API key de Roboflow (NUNCA se hardcodea; leer SIEMPRE desde aquí).
# Común a ambos modos (workflow y modelo estándar).
ROBOFLOW_API_KEY=
# URL del servidor de inferencia serverless de Roboflow.
ROBOFLOW_API_URL=https://serverless.roboflow.com

# --- Vision Cloud (Modelo estándar, alternativo) ---
# Usar solo si NO usas workflows. Si hay WORKFLOW_ID configurado, el motor
# prioriza el modo workflow e ignora este valor (con warning en logs).
ROBOFLOW_MODEL_ID=                # ej: proyecto/1

# --- Modo Local (Opción 3 — Inferencia Edge con paquete 'inference') ---
# ID del modelo para inferencia local (puede ser distinto del cloud).
# Si no se define, se usa ROBOFLOW_MODEL_ID como fallback.
ROBOFLOW_LOCAL_MODEL_ID=
# Dispositivo de inferencia local: cpu | cuda
INFERENCE_DEVICE=cpu
# Número de workers para la cola productor-consumidor (modo local).
LOCAL_INFERENCE_WORKERS=2
# Intervalo de muestreo en segundos (modo cloud).
SAMPLE_INTERVAL=1.5
